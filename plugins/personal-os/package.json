{
  "name": "bb-plugin-personal-os",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Read-only Personal OS goals and work through an enrolled BB host.",
  "engines": { "bb": ">=0.0", "bbPluginSdk": ">=0.6.53" },
  "bb": {
    "name": "Personal OS",
    "description": "Goals, next steps and task evidence from the local Personal OS.",
    "branding": { "icon": "LayoutDashboard" },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "keywords": ["bb-plugin"],
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": { "@bb/shared-ui": "workspace:*", "react-markdown": "^10.1.0", "remark-gfm": "^4.0.1", "zod": "^4.3.6" },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
